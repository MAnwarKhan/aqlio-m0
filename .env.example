# APP
APP_ENV=development
APP_BASE_URL=http://localhost:8501
SUPPORT_CONTACT=support@example.com
LOG_LEVEL=INFO

# DATABASE (required in pilot, unused by deterministic development adapters)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/aqlio

# AUTH
AQLIO_AUTH_MODE=development
OIDC_PROVIDER=google
ADMIN_EMAILS=

# OBJECT_STORAGE (required in pilot)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# AI
AQLIO_AI_MODE=fake
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=
OPENAI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ALLOWANCES / UPLOADS
DAILY_AI_REQUEST_ALLOWANCE=25
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_PROJECT=5
MAX_PROJECT_STORAGE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,txt
